{
    "name": "emerson-ph/ai-team-setup",
    "description": "AI Team Setup for Laravel projects - Configure Claude Code, GitHub Copilot, Cursor, and other AI tools with role-based strategy council",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Emerson",
            "email": "gonzalesemerson079@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "laravel/framework": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Emerson\\AITeamSetup\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emerson\\AITeamSetup\\AITeamSetupServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "keywords": [
        "laravel",
        "ai",
        "claude",
        "copilot",
        "cursor",
        "strategy",
        "team"
    ]
}
