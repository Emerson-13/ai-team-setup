{
  "id": "aiChatAgent01",
  "name": "AI Chat Agent (Laravel)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-chat",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "df82d645-dc3f-4b5f-9ca8-eff9bda14670",
      "name": "Webhook",
      "webhookId": "a7491bfb-a13b-46f2-baec-867f8be09bca",
      "notes": "Laravel calls this URL. Set the credential: Header Auth, name X-N8N-Secret, value = your secret."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "={{ $json.body.system_prompt || 'You are a helpful assistant for our platform. Answer briefly and clearly. If you do not know, say so.' }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        300,
        0
      ],
      "id": "1ae5a59b-a496-4ebe-ad3a-e6b4b0611bd5",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "id"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        220,
        240
      ],
      "id": "6da905f5-015e-4b4f-b5f2-6328c96d66a2",
      "name": "Chat Model",
      "notes": "Pick YOUR credential here. To use another provider (Anthropic, Gemini, Groq, Ollama...), delete this node, add that provider's Chat Model node, and connect it to the same input."
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Webhook').item.json.body.session_id }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        380,
        240
      ],
      "id": "de71657b-6113-4a9f-8aa7-cc8158281236",
      "name": "Conversation Memory",
      "notes": "Keeps the last 10 messages per session_id. No setup needed."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"reply\": $json.output } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        620,
        0
      ],
      "id": "65c140e3-2370-444d-b1b1-2400db94f7e9",
      "name": "Respond to Laravel"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Laravel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Conversation Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
