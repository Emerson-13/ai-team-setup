APP_NAME="App E2E"
APP_ENV=e2e
APP_KEY=                     # php artisan key:generate --show   (paste the value)
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001

# MySQL only. The database name MUST end with _e2e (the suite refuses anything else).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_e2e
DB_USERNAME=root
DB_PASSWORD=

# sync = jobs and broadcasts run inline during the request: no worker process needed in E2E.
QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=database
MAIL_MAILER=log

# Realtime (only if the app uses Reverb). Vite reads VITE_* from this file when built with --mode e2e.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=e2e-app
REVERB_APP_KEY=e2e-key
REVERB_APP_SECRET=e2e-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
